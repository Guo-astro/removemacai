<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld changes ready</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld değişiklik hazır</string>
			<key>other</key>
			<string>%lld değişiklik hazır</string>
		</dict>
	</dict>
	<key>%lld features are kept on. Everything else is off and its models are gone.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld özellik açık tutuluyor. Geri kalan her şey kapalı ve modelleri silindi.</string>
			<key>other</key>
			<string>%lld özellik açık tutuluyor. Geri kalan her şey kapalı ve modelleri silindi.</string>
		</dict>
	</dict>
	<key>%lld items macOS protects stayed where they were.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>macOS'un koruduğu %lld öğe yerinde kaldı.</string>
			<key>other</key>
			<string>macOS'un koruduğu %lld öğe yerinde kaldı.</string>
		</dict>
	</dict>
	<key>%lld settings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ayar</string>
			<key>other</key>
			<string>%lld ayar</string>
		</dict>
	</dict>
	<key>%lld settings and Apple Intelligence off</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ayar ve Apple Intelligence kapalı</string>
			<key>other</key>
			<string>%lld ayar ve Apple Intelligence kapalı</string>
		</dict>
	</dict>
	<key>%lld snapshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld anlık görüntü</string>
			<key>other</key>
			<string>%lld anlık görüntü</string>
		</dict>
	</dict>
	<key>Turn off everything except %lld kept features</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Açık tutulan %lld özellik dışında her şeyi kapat</string>
			<key>other</key>
			<string>Açık tutulan %lld özellik dışında her şeyi kapat</string>
		</dict>
	</dict>
</dict>
</plist>
