<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld changes ready</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld बदलाव तैयार है</string>
			<key>other</key>
			<string>%lld बदलाव तैयार हैं</string>
		</dict>
	</dict>
	<key>%lld features are kept on. Everything else is off and its models are gone.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld सुविधा चालू रखी गई है। बाकी सब बंद है और उसके मॉडल हटा दिए गए हैं।</string>
			<key>other</key>
			<string>%lld सुविधाएँ चालू रखी गई हैं। बाकी सब बंद है और उसके मॉडल हटा दिए गए हैं।</string>
		</dict>
	</dict>
	<key>%lld items macOS protects stayed where they were.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>macOS से सुरक्षित %lld आइटम अपनी जगह पर रहा।</string>
			<key>other</key>
			<string>macOS से सुरक्षित %lld आइटम अपनी जगह पर रहे।</string>
		</dict>
	</dict>
	<key>%lld settings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld सेटिंग</string>
			<key>other</key>
			<string>%lld सेटिंग्ज़</string>
		</dict>
	</dict>
	<key>%lld settings and Apple Intelligence off</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld सेटिंग और Apple Intelligence बंद</string>
			<key>other</key>
			<string>%lld सेटिंग्ज़ और Apple Intelligence बंद</string>
		</dict>
	</dict>
	<key>%lld snapshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld स्नैपशॉट</string>
			<key>other</key>
			<string>%lld स्नैपशॉट</string>
		</dict>
	</dict>
	<key>Turn off everything except %lld kept features</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld रखी गई सुविधा को छोड़कर सब कुछ बंद करें</string>
			<key>other</key>
			<string>%lld रखी गई सुविधाओं को छोड़कर सब कुछ बंद करें</string>
		</dict>
	</dict>
</dict>
</plist>
