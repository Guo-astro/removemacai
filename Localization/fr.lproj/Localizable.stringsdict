<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld changes ready</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld modification prête</string>
			<key>many</key>
			<string>%lld modifications prêtes</string>
			<key>other</key>
			<string>%lld modifications prêtes</string>
		</dict>
	</dict>
	<key>%lld features are kept on. Everything else is off and its models are gone.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld fonction reste activée. Tout le reste est désactivé et ses modèles ont disparu.</string>
			<key>many</key>
			<string>%lld fonctions restent activées. Tout le reste est désactivé et leurs modèles ont disparu.</string>
			<key>other</key>
			<string>%lld fonctions restent activées. Tout le reste est désactivé et leurs modèles ont disparu.</string>
		</dict>
	</dict>
	<key>%lld items macOS protects stayed where they were.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld élément protégé par macOS est resté en place.</string>
			<key>many</key>
			<string>%lld éléments protégés par macOS sont restés en place.</string>
			<key>other</key>
			<string>%lld éléments protégés par macOS sont restés en place.</string>
		</dict>
	</dict>
	<key>%lld settings</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld réglage</string>
			<key>many</key>
			<string>%lld réglages</string>
			<key>other</key>
			<string>%lld réglages</string>
		</dict>
	</dict>
	<key>%lld settings and Apple Intelligence off</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld réglage et Apple Intelligence désactivé</string>
			<key>many</key>
			<string>%lld réglages et Apple Intelligence désactivé</string>
			<key>other</key>
			<string>%lld réglages et Apple Intelligence désactivé</string>
		</dict>
	</dict>
	<key>%lld snapshots</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld instantané</string>
			<key>many</key>
			<string>%lld instantanés</string>
			<key>other</key>
			<string>%lld instantanés</string>
		</dict>
	</dict>
	<key>Turn off everything except %lld kept features</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Tout désactiver sauf %lld fonction conservée</string>
			<key>many</key>
			<string>Tout désactiver sauf %lld fonctions conservées</string>
			<key>other</key>
			<string>Tout désactiver sauf %lld fonctions conservées</string>
		</dict>
	</dict>
</dict>
</plist>
